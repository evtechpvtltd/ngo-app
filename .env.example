# Bhoirwadi Sanskritik Association — environment variable template
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit a file containing real credentials. Only .env.example
# (with placeholder values) belongs in source control. See SECURITY.md
# and docs/security.md.
#
# Variables are validated at startup with Zod — see lib/config/env.public.ts
# and lib/config/env.server.ts. The app will fail fast with a clear error
# if a required variable is missing or malformed.

# ---------------------------------------------------------------------------
# PUBLIC — safe to expose to the browser (lib/config/env.public.ts)
# ---------------------------------------------------------------------------

# Your Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous/public key (Project Settings -> API).
# This key is safe for the browser ONLY because RLS is enforced on every
# exposed table. It must never be confused with the service-role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public base URL of this deployment (used for manifest, share links, CSP).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Displayed app version (defaults to package.json version if unset).
NEXT_PUBLIC_APP_VERSION=0.0.1

# ---------------------------------------------------------------------------
# SERVER-ONLY — must never reach the browser bundle (lib/config/env.server.ts)
# ---------------------------------------------------------------------------

# Supabase SERVICE ROLE key. This bypasses Row Level Security entirely.
# - Never prefix this with NEXT_PUBLIC_
# - Never import it from a Client Component
# - Only used from lib/supabase/admin.ts, which is structurally restricted
#   to server-only code via the `server-only` package and eslint rules.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Build identifier surfaced by GET /api/v1/system/version. Set by CI in real
# deployments; safe to leave as "dev" locally.
APP_BUILD_ID=dev

NODE_ENV=development
